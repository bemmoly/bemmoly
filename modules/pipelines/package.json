{
  "name": "@bemmoly/module-pipelines",
  "version": "1.6.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./module.ts",
    "./shared": "./shared/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:demo": "pnpm --filter @bemmoly/server db modules enable pipelines --access everyone && node --env-file-if-exists=../../apps/server/.env scripts/seed-demo.ts",
    "demo:runner": "node --env-file-if-exists=../../apps/server/.env scripts/runner-demo.ts",
    "demo:live": "node --env-file-if-exists=../../apps/server/.env scripts/demo-live.ts",
    "bench:dispatch": "node --env-file-if-exists=../../apps/server/.env scripts/dispatch-benchmark.ts",
    "demo:local": "node --env-file-if-exists=../../apps/server/.env scripts/local-demo.ts",
    "demo:monorepo": "node --env-file-if-exists=../../apps/server/.env scripts/monorepo-demo.ts",
    "capture:gcp": "node scripts/capture-gcp-fixtures.ts"
  },
  "dependencies": {
    "@bemmoly/core": "workspace:*",
    "@bemmoly/shared": "workspace:*",
    "@marcbachmann/cel-js": "8.0.0",
    "cron-parser": "5.10.1",
    "fastify": "5.12.5",
    "google-auth-library": "10.9.1",
    "yaml": "2.8.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "vitest": "5.0.3"
  }
}

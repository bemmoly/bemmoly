{
  "name": "@bemmoly/shared",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ai-insights": "./src/schemas/ai/insights.ts",

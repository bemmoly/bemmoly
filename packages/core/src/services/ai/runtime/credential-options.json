{
  "protocols": {
    "openai-compatible": "@ai-sdk/openai-compatible",
    "anthropic-compatible": "@ai-sdk/anthropic"
  },
  "compatible": "@ai-sdk/openai-compatible",
  "suffixes": [
    { "suffix": "_SECRET_ACCESS_KEY", "option": "secretAccessKey" },
    { "suffix": "_ACCESS_KEY_ID", "option": "accessKeyId" },
    { "suffix": "_SESSION_TOKEN", "option": "sessionToken" },
    {
      "suffix": "_APPLICATION_CREDENTIALS",
      "option": "googleAuthOptions.credentials",
      "json": true
    },
    { "suffix": "_RESOURCE_NAME", "option": "resourceName" },
    { "suffix": "_API_VERSION", "option": "apiVersion" },
    { "suffix": "_ACCOUNT_ID", "option": "accountId" },
    { "suffix": "_BASE_URL", "option": "baseURL" },
    { "suffix": "_ENDPOINT", "option": "baseURL" },
    { "suffix": "_PROJECT", "option": "project" },
    { "suffix": "_LOCATION", "option": "location" },
    { "suffix": "_REGION", "option": "region" },
    { "suffix": "_API_KEY", "option": "apiKey" },
    { "suffix": "_TOKEN", "option": "apiKey" },
    { "suffix": "_KEY", "option": "apiKey" }
  ]
}

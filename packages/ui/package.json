{
  "name": "@bemmoly/ui",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./theme": "./src/theme/index.ts",
    "./custom-theme": "./src/theme/custom.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/all": "./src/icons/all.ts",
    "./ai-answer": "./src/components/ai-surface/ai-answer.tsx",
    "./ai-insight-body": "./src/components/ai-surface/ai-insight-body.tsx",
    "./time": "./src/lib/time.ts",
    "./intl": "./src/lib/intl.ts",
    "./theme.css": "./src/theme.css",
    "./tailwind.css": "./src/tailwind.css",
    "./fonts.css": "./src/fonts.css",
    "./brand/*": "./assets/brand/*"
  },
  "scripts": {
    "build": "storybook build --quiet --output-dir storybook-static",
    "storybook": "storybook dev --port 6006 --no-open",
    "tokens:css": "node scripts/generate-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "brand:marks": "node scripts/brand-marks.ts",
    "brand:icons": "node scripts/brand-icons.ts",
    "brand:banners": "node ../../docs/launch-kit/src/render.ts --skip-capture --brand-only",
    "brand:captures": "node ../../docs/launch-kit/src/capture.ts"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "lucide-react": "1.47.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "tools/eslint-plugin/src/**",
    ".pnpmfile.cjs"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "@bemmoly/site#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/SECURITY.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "@bemmoly/site#lint": {
      "dependsOn": ["@bemmoly/site#build"]
    },
    "//#lint:root": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "@bemmoly/site#test": {
      "dependsOn": ["@bemmoly/site#build"]
    },
    "test:integration": {
      "cache": false,
      "env": ["BEMMOLY_TEST_DATABASE_URL", "DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "size": {
      "dependsOn": ["build"]
    },
    "//#format": {
      "cache": false
    },
    "//#typecheck:root": {}
  },
  "agentGuidance": false
}

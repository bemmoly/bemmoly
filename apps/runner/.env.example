# bemmoly-runner reads these when the matching flag is not given (see bemmoly-runner --help).
BEMMOLY_URL=http://localhost:5616
# The pool's registration token; needed only until the first registration is saved.
BEMMOLY_POOL_TOKEN=
BEMMOLY_RUNNER_NAME=
# Comma-separated, for example linux,arm64
BEMMOLY_RUNNER_LABELS=
# true runs steps as processes on this machine instead of containers
BEMMOLY_RUNNER_LOCAL=false
# With BEMMOLY_RUNNER_LOCAL=true: run every job in this folder, without a check out
BEMMOLY_RUNNER_WORKSPACE=
BEMMOLY_RUNNER_DATA_DIR=~/.bemmoly-runner
# true exits after one job
BEMMOLY_RUNNER_ONCE=false
# unix:///path/to/docker.sock; Colima's socket is found without it
DOCKER_HOST=
LOG_LEVEL=info

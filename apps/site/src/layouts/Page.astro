---
/**
 * Text pages (self-hosting, docs, topic pages, security, changelog, community). The site
 * review's guide draws the title at the 44px section size (32px on a phone) over a 19px lede;
 * the column is 1160px, narrowed to a 760px reading measure unless `wide` (pages laid out in
 * cards). Pages below a section (/docs/install) show the way back above the heading.
 */
import { trailOf, type SitePage } from '../data/pages.ts';
import type { FaqItem } from '../lib/structured-data.ts';
import Base from './Base.astro';

interface Props {
  page: SitePage;
  /** The visible heading; the page's short name when omitted. */
  heading?: string;
  lede: string;
  wide?: boolean;
  noindex?: boolean;
  faq?: readonly FaqItem[];
  alternate?: { href: string; type: string; title: string };
}

const {
  page,
  heading = page.name,
  lede,
  wide = false,
  noindex = false,
  faq,
  alternate,
} = Astro.props;
const parents = trailOf(page.path).slice(1, -1);
---

<Base page={page} noindex={noindex} faq={faq} alternate={alternate}>
  <article
    class:list={[
      'mx-auto flex w-full flex-col gap-12 px-4 pt-16 pb-20 sm:px-6 lg:pt-20',
      wide ? 'max-w-290 lg:px-12' : 'max-w-190',
    ]}
  >
    <header class="flex max-w-190 flex-col gap-4">
      {parents.length > 0 && (
        <nav aria-label="Breadcrumb" class="text-13 text-tx-3">
          {parents.map((parent) => (
            <>
              <a href={parent.path} class="text-tx-2 underline underline-offset-2 hover:text-tx">
                {parent.name}
              </a>
              <span aria-hidden="true"> / </span>
            </>
          ))}
          <span aria-current="page">{page.name}</span>
        </nav>
      )}
      <h1 class="text-32 font-semibold tracking-section text-balance md:text-44">{heading}</h1>
      <p class="text-17 leading-brief text-pretty text-tx-2 md:text-19">{lede}</p>
    </header>
    <slot />
  </article>
</Base>

---
/**
 * Questions and answers in the page's own text. The same list feeds the page's FAQPage data
 * (Base.astro), so the structured data never says anything the page does not.
 */
import type { FaqItem } from '../../lib/structured-data.ts';
import Section from '../site/Section.astro';

interface Props {
  items: readonly FaqItem[];
}

const { items } = Astro.props;
---

<Section title="Questions" id="questions">
  <dl class="flex flex-col gap-5">
    {items.map((item) => (
      <div class="flex flex-col gap-1.5">
        <dt class="text-15 font-semibold text-tx">{item.question}</dt>
        <dd>{item.answer}</dd>
      </div>
    ))}
  </dl>
</Section>

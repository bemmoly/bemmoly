---
/**
 * The topic pages' board picture: the homepage's board poster of the new UI, captured from the
 * live demo in light and dark (scripts/capture-previews.ts), with a caption that says what it
 * is and links to the demo.
 */
import { POSTERS, POSTER_WIDTHS } from '../../data/posters.ts';
import { PREVIEWS } from '../../data/previews.ts';
import Poster from '../site/Poster.astro';

interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
const preview = PREVIEWS.find((entry) => entry.id === 'board');
---

<figure class="m-0 flex flex-col gap-3">
  <div class="overflow-hidden rounded-shot bg-card shadow-e3">
    <Poster
      {...POSTERS.board}
      alt={preview?.alt ?? ''}
      widths={POSTER_WIDTHS}
      sizes="(min-width: 1160px) 1064px, calc(100vw - 32px)"
      eager={eager}
    />
  </div>
  <figcaption class="text-13 leading-brief text-tx-3">
    The Work module’s board in the live demo, on sample data that stays in your browser.
    <a href={preview?.path} class="font-medium underline">
      Drag a card yourself.
    </a>
  </figcaption>
</figure>

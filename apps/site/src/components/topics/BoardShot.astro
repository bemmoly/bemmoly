---
/**
 * The topic pages' board picture: the homepage's board poster, captured from the live demo
 * (scripts/capture-previews.ts), with a caption that says what it is and links to the demo.
 */
import boardOcean from '../../assets/previews/board-ocean.png';
import board from '../../assets/previews/board.png';
import { PREVIEWS } from '../../data/previews.ts';
import Shot from '../landing/Shot.astro';

interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
const preview = PREVIEWS.find((entry) => entry.id === 'board');
---

<figure class="m-0 flex flex-col gap-3">
  <Shot
    src={board}
    dark={boardOcean}
    frame="wide"
    width={1064}
    sizes="(min-width: 1160px) 1064px, calc(100vw - 32px)"
    eager={eager}
    alt={preview?.alt ?? ''}
  />
  <figcaption class="text-13h leading-brief text-tx4">
    The Work module’s board in the live demo, on sample data.
    <a href={preview?.path} class="font-medium underline">
      Drag a card yourself
    </a>
    ; nothing you change leaves your browser.
  </figcaption>
</figure>

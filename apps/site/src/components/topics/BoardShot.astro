---
/**
 * The landing page's board picture with a caption that says what it is: a capture of the
 * Board design mock the Work module's board is built to, not a screenshot of a release.
 */
import boardOcean from '../../assets/screens/board-ocean.png';
import board from '../../assets/screens/board.png';
import Shot from '../landing/Shot.astro';

interface Props {
  eager?: boolean;
}

const { eager = false } = Astro.props;
---

<figure class="m-0 flex flex-col gap-3">
  <Shot
    src={board}
    dark={boardOcean}
    frame="wide"
    width={1064}
    sizes="(min-width: 1160px) 1064px, calc(100vw - 32px)"
    eager={eager}
    alt="A sprint board in Bemmoly with an AI sprint-risk note, swimlanes by epic and an issue open beside the board."
  />
  <figcaption class="text-13h leading-brief text-tx4">
    The board design the Work module is built to, including the AI note planned for 0.4. It is a
    picture of the design, not a screenshot of a release.
  </figcaption>
</figure>

---
/**
 * The first steps of the setup wizard, in words. The pictures that were here were crops of the
 * old Setup mock, one of which promised single sign-on, which is not built; the setup guide's
 * own redesign draws the new wizard.
 */
import StepNumber from './StepNumber.astro';

const STEPS = [
  {
    title: 'Open the URL and create the first admin',
    body: 'The first visit runs a short setup: the workspace’s name, then the account that owns it, created on your server.',
  },
  {
    title: 'Invite your team',
    body: 'Paste email addresses, pick a role and a team, and Bemmoly sends the invitations through your mail server.',
  },
  {
    title: 'Turn on Work and Docs',
    body: 'Modules start switched off. In Settings › Modules, turn on Work, Docs or both, and choose who can use each.',
  },
];
---

<section
  id="after-install"
  aria-labelledby="after-install-title"
  class="flex scroll-mt-20 flex-col gap-6"
>
  <div class="flex flex-col gap-2">
    <h2 id="after-install-title" class="text-20 leading-title font-semibold tracking-title text-tx">
      After install
    </h2>
    <p class="text-16 leading-desc text-tx-2">
      Whichever path you took, the rest happens in the browser.
    </p>
  </div>
  <ol class="grid gap-8 md:grid-cols-3 md:gap-6">
    {STEPS.map((step, i) => (
      <li class="flex items-start gap-3">
        <StepNumber n={i + 1} />
        <div class="flex flex-col gap-1">
          <h3 class="text-16 font-semibold text-tx">{step.title}</h3>
          <p class="text-14h leading-desc text-tx-2">{step.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

---
/**
 * One "Other ways to run it" card: the situation as its title, an honest status badge, what to
 * do, and the commands, one block per step. A way that is coming soon shows no command. The
 * chooser's pick takes the Setup mock's selected-card look (accent border and ring).
 */
import type { PathOption } from '../../data/paths.ts';
import { STATUS } from '../../data/self-hosting.ts';
import Badge from '../site/Badge.astro';
import CodeBlock from '../site/CodeBlock.astro';
import Icon from '../site/Icon.astro';

interface Props {
  path: PathOption;
}

const { path } = Astro.props;
const status = STATUS[path.status];
const external = path.link?.href.startsWith('http') ?? false;
---

<li
  id={path.id}
  data-path={path.id}
  class:list={[
    'group flex min-w-0 scroll-mt-20 flex-col gap-3.5 rounded-window border border-line bg-card p-5 data-pick:border-acc data-pick:shadow-ring',
    path.wide && 'md:col-span-2',
  ]}
>
  <div class="flex items-start gap-3">
    <span
      aria-hidden="true"
      class="flex size-9 shrink-0 items-center justify-center rounded-card bg-acc-50 text-acc"
    >
      <Icon name={path.icon} size={18} />
    </span>
    <div class="flex min-w-0 flex-col gap-1.5">
      <h3 class="text-17 font-semibold tracking-brand text-tx">{path.title}</h3>
      <div class="flex flex-wrap items-center gap-2">
        <Badge tone={status.tone}>{status.label}</Badge>
        <span class="hidden group-data-pick:inline-flex">
          <Badge tone="solid">Matches your answers</Badge>
        </span>
      </div>
    </div>
  </div>
  <p class="text-14h leading-desc text-pretty text-tx-2">{path.body}</p>
  {path.steps?.map((step) => (
    <CodeBlock code={step.code} label={step.label} copy />
  ))}
  {path.note && <p class="text-13 leading-brief text-tx-3">{path.note}</p>}
  {path.link && (
    <a href={path.link.href} class="mt-auto inline-flex items-center gap-1 text-13 font-medium">
      {path.link.label}
      <Icon name={external ? 'external' : 'arrow'} size={14} />
    </a>
  )}
</li>

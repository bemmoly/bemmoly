---
/**
 * Live slices of the demo in the hero frame. Each tab shows a poster captured from its demo
 * route (scripts/capture-previews.ts); "Try it" swaps in the demo itself, framed at the
 * poster's size and scaled to fit, so nothing moves. Without JavaScript, or on a phone, the
 * tabs and the button are links to the full demo. The script (preview.ts) loads nothing until
 * someone asks for the live view.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import boardOcean from '../../assets/previews/board-ocean.png';
import board from '../../assets/previews/board.png';
import issueOcean from '../../assets/previews/issue-ocean.png';
import issue from '../../assets/previews/issue.png';
import workflowOcean from '../../assets/previews/workflow-ocean.png';
import workflow from '../../assets/previews/workflow.png';
import { PREVIEW_VIEWPORT, PREVIEWS } from '../../data/previews.ts';
import { DEMO_URL } from '../../lib/links.ts';

const POSTERS: Record<string, { light: ImageMetadata; dark: ImageMetadata }> = {
  board: { light: board, dark: boardOcean },
  issue: { light: issue, dark: issueOcean },
  workflow: { light: workflow, dark: workflowOcean },
};
const WIDTH = 1184;
const sizes = '(min-width: 1280px) 1184px, calc(100vw - 32px)';

async function sources(image: ImageMetadata) {
  const widths = [...new Set([400, 800, WIDTH, image.width])].filter((w) => w <= image.width);
  const [avif, webp, fallback] = await Promise.all([
    getImage({ src: image, format: 'avif', widths }),
    getImage({ src: image, format: 'webp', widths }),
    getImage({ src: image, format: 'webp', width: WIDTH }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: fallback.src };
}

const views = await Promise.all(
  PREVIEWS.map(async (preview, index) => {
    const poster = POSTERS[preview.id];
    if (!poster) throw new Error(`No poster for ${preview.id}`);
    return {
      ...preview,
      first: index === 0,
      pictures: [
        { image: poster.light, set: await sources(poster.light), theme: 'light' },
        { image: poster.dark, set: await sources(poster.dark), theme: 'dark' },
      ],
    };
  }),
);
const [first] = views;
---

<figure
  class="m-0 flex flex-col gap-3"
  data-preview
  data-width={PREVIEW_VIEWPORT.width}
  data-height={PREVIEW_VIEWPORT.height}
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <div class="flex rounded-control bg-line-2 p-0.5 text-13" data-tabs>
      {views.map((view) => (
        <a
          href={view.path}
          id={`preview-tab-${view.id}`}
          data-tab={view.id}
          data-action={view.action}
          data-active={view.first ? '' : undefined}
          class="rounded-chip px-3 py-1 font-medium text-tx-2 hover:text-tx data-active:bg-card data-active:text-tx data-active:shadow-e1"
        >
          {view.label}
        </a>
      ))}
    </div>
    <a href={DEMO_URL} class="text-13 font-medium" data-full>
      Open the full demo
    </a>
  </div>
  <div
    id="preview-panel"
    data-frame
    class="relative isolate aspect-[1480/860] overflow-hidden rounded-shot border border-line bg-sunken shadow-e3"
  >
    {views.map((view) =>
      view.pictures.map(({ image, set, theme }) => (
        <picture
          data-poster={view.id}
          hidden={!view.first}
          class={theme === 'light' ? 'dark:hidden' : 'hidden dark:block'}
        >
          <source type="image/avif" srcset={set.avif} sizes={sizes} />
          <source type="image/webp" srcset={set.webp} sizes={sizes} />
          <img
            src={set.fallback}
            alt={view.alt}
            width={image.width}
            height={image.height}
            loading={view.first && theme === 'light' ? 'eager' : 'lazy'}
            fetchpriority={view.first && theme === 'light' ? 'high' : 'auto'}
            decoding="async"
            class="block h-full w-full object-cover object-top"
          />
        </picture>
      )),
    )}
    <a
      href={first?.path}
      data-try
      class="absolute bottom-3 left-1/2 z-2 inline-flex h-8 -translate-x-1/2 items-center gap-2 rounded-full bg-tx px-3.5 text-13 font-medium sm:bottom-5 sm:h-10 sm:px-4.5 sm:text-14 whitespace-nowrap text-card shadow-e2 hover:text-card dark:bg-acc-fill dark:text-on-acc dark:hover:text-on-acc motion-safe:transition-transform motion-safe:hover:-translate-y-0.5"
    >
      <span
        aria-hidden="true"
        class="size-0 border-y-[5px] border-l-[8px] border-y-transparent border-l-current"
      ></span>
      <span>
        Try it live: <span data-try-label>{first?.action}</span>
      </span>
    </a>
  </div>
  <figcaption class="text-13 leading-brief text-tx-3">
    The real app on sample data, running in your browser. Nothing you change leaves the page, and a
    reload starts over.
  </figcaption>
</figure>

---
import { PROOF_POINTS, RELEASE } from '../../data/landing.ts';
import { DEMO_URL } from '../../lib/links.ts';
import Button from '../site/Button.astro';
import InstallCommand from './InstallCommand.astro';
---

<section class="hero-glow relative isolate mx-auto flex w-full max-w-290 flex-col items-center gap-7 px-4 pt-16 pb-14 text-center sm:px-6 lg:px-12 lg:pt-22">
  <p class="inline-flex items-center gap-2 rounded-full border border-line bg-side py-1.25 dark:bg-card pr-3 pl-1.5 text-13 text-tx-2">
    <span class="rounded-full bg-green-50 px-2 py-0.5 text-12 font-semibold text-green-tx">
      {RELEASE.version}
    </span>
    {RELEASE.note}
  </p>
  <h1 class="max-w-225 text-24 leading-hero font-semibold tracking-hero text-balance md:text-58">
    Keep your work in-house.
  </h1>
  <p class="max-w-175 text-19 leading-brief text-pretty text-tx-2">
    Issues, boards and docs for your whole company, on a server you own. Your work stays in your
    Postgres, behind your login. No pricing, no seat limits, nothing to buy.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button variant="primary" href="/self-hosting#recommended">
      Install
    </Button>
    <Button variant="secondary" href={DEMO_URL}>
      Try the live demo
    </Button>
  </div>
  <InstallCommand />
  <ul class="flex flex-wrap justify-center gap-x-7 gap-y-2 text-13 text-tx-3">
    {PROOF_POINTS.map((point) => (
      <li>{point}</li>
    ))}
  </ul>
</section>

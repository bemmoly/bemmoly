---
/**
 * AI, as it ships: one band in the lilac that means AI and only AI, its release read from the
 * changelogs, what it does today (the release notes), and a real AI card captured from the
 * live demo. It answers "do I need AI?" and "will it read my data?" with what is true: it is
 * off until an admin turns it on, with the provider the admin chooses.
 */
import { AI_FEATURES } from '../../data/landing.ts';
import { AI_POSTER } from '../../data/previews.ts';
import { AI_POSTERS } from '../../data/posters.ts';
import { AI_SINCE, shippedLabel } from '../../lib/changelog.ts';
import Badge from '../site/Badge.astro';
import Icon from '../site/Icon.astro';
import ModuleTile from '../site/ModuleTile.astro';
import Poster from '../site/Poster.astro';
---

<section
  id="ai"
  aria-labelledby="ai-title"
  class="mx-auto max-w-300 scroll-mt-16 px-4 py-10 sm:px-6 md:py-18 lg:px-8"
>
  <div class="grid items-center gap-8 rounded-band bg-ai-50 p-6 md:p-10 lg:grid-cols-2 lg:gap-12 lg:px-11">
    <div class="flex flex-col">
      <div class="flex items-center gap-2.5">
        <ModuleTile module="ai" size={28} />
        <b class="text-15 font-semibold">AI</b>
        <Badge tone="ai" pill class="bg-card!">
          {shippedLabel(AI_SINCE)}, optional
        </Badge>
      </div>
      <h2
        id="ai-title"
        class="mt-4 mb-3 text-24 font-semibold tracking-sub text-balance md:text-32"
      >
        AI is here, and stays optional.
      </h2>
      <p class="text-16 leading-desc text-pretty text-tx-2">
        It is off until an admin turns it on. Then bring a provider from the models.dev catalog or a
        model on your own network; Settings decides what it may read and change. Everything else on
        this page works without it.
      </p>
      <ul class="mt-5 flex flex-col gap-2.5">
        {AI_FEATURES.map((item) => (
          <li class="grid grid-cols-[22px_1fr] gap-2.5 text-15 leading-body text-tx-2">
            <Icon name="spark" size={16} class="mt-0.75 text-ai-600" />
            <span>
              <b class="font-semibold text-tx">{item.lead}</b>, {item.rest}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <figure class="m-0 flex flex-col gap-3">
      <div class="overflow-hidden rounded-shot bg-card shadow-[0_0_0_1px_var(--ai-100)]">
        <Poster
          {...AI_POSTERS}
          alt={AI_POSTER.alt}
          widths={[640, 1360]}
          sizes="(min-width: 1024px) 520px, calc(100vw - 80px)"
        />
      </div>
      <figcaption class="pl-1 text-13 text-tx-2">
        An issue’s summary in the{' '}
        <a href={AI_POSTER.path} class="font-medium text-tx underline">
          live demo
        </a>
        , where AI is on. Lilac on this site means AI, and only AI.
      </figcaption>
    </figure>
  </div>
</section>

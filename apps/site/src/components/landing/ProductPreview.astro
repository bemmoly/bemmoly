---
/**
 * The product, four views: tabs over posters of the new UI captured from the demo, and "Try it
 * live", which starts the real demo in place at the poster's size (src/lib/client/preview.ts).
 * Poster first, always: without the script the tabs are links to the demo's routes. While the
 * demo starts, a skeleton at the poster's layout says what is happening; if it has not drawn in
 * eight seconds, the frame says so plainly and offers Retry and a new tab.
 */
import { POSTERS, POSTER_WIDTHS } from '../../data/posters.ts';
import { PREVIEW_VIEWPORT, PREVIEWS } from '../../data/previews.ts';
import { DEMO_URL } from '../../lib/links.ts';
import Icon from '../site/Icon.astro';
import Poster from '../site/Poster.astro';

const sizes = '(min-width: 1248px) 1200px, calc(100vw - 48px)';
const [first] = PREVIEWS;
---

<figure
  id="preview"
  data-preview
  data-width={PREVIEW_VIEWPORT.width}
  data-height={PREVIEW_VIEWPORT.height}
  aria-label="Product preview"
  class="m-0 flex scroll-mt-20 flex-col gap-3.5"
>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <div
      data-tabs
      data-label="Views of the product"
      class="inline-flex gap-0.5 rounded-[10px] bg-sunken p-0.75 shadow-[inset_0_0_0_1px_var(--line)]"
    >
      {PREVIEWS.map((view, index) => (
        <a
          href={view.path}
          id={`preview-tab-${view.id}`}
          data-tab={view.id}
          data-active={index === 0 ? '' : undefined}
          aria-controls="preview-frame"
          class="inline-flex h-8 items-center gap-1.75 rounded-[7px] px-3.25 text-14 font-medium text-tx-2 hover:text-tx data-active:bg-card data-active:text-tx data-active:shadow-e1"
        >
          <Icon name={view.icon} size={15} />
          {view.label}
        </a>
      ))}
    </div>
    <p class="m-0 inline-flex items-center gap-2 text-14 text-tx-3">
      <Icon name="eye" size={15} />
      <span>
        The real app on sample data,
        <a href={first?.path ?? DEMO_URL} data-follow class="underline underline-offset-3">
          open the full demo
        </a>
      </span>
    </p>
  </div>
  <div
    id="preview-frame"
    data-frame
    class="relative isolate aspect-[1280/744] overflow-hidden rounded-shot bg-card shadow-e3"
  >
    {PREVIEWS.map((view, index) => (
      <Poster
        {...POSTERS[view.id]}
        alt={view.alt}
        widths={POSTER_WIDTHS}
        sizes={sizes}
        hidden={index > 0}
        data-poster={view.id}
        class="h-full object-cover object-top"
      />
    ))}
    <div data-loading hidden class="absolute inset-0 z-2 bg-canvas">
      <div class="grid h-full grid-cols-[18%_1fr] gap-[2%] p-[2%]" aria-hidden="true">
        <div class="flex flex-col gap-3">
          {Array.from({ length: 8 }, () => (
            <div class="h-3 rounded-[6px] bg-line-2" />
          ))}
        </div>
        <div class="flex flex-col gap-4">
          <div class="h-4 w-2/5 rounded-[6px] bg-line-2" />
          <div class="grid grid-cols-4 gap-3">
            {Array.from({ length: 8 }, () => (
              <div class="h-20 rounded-card bg-line-2" />
            ))}
          </div>
        </div>
      </div>
      <p
        role="status"
        class="absolute inset-x-0 bottom-0 m-0 flex items-center gap-2.5 border-t border-line bg-card px-4 py-2.5 text-13 text-tx-2"
      >
        <span
          class="size-3.5 rounded-full border-2 border-acc border-r-transparent motion-safe:animate-spin"
          aria-hidden="true"
        ></span>
        Starting the demo in your browser…
      </p>
    </div>
    <div
      data-failed
      hidden
      role="alert"
      class="absolute inset-0 z-3 grid place-items-center bg-sunken p-6 text-center"
    >
      <div class="flex flex-col items-center gap-1">
        <span class="mb-2.5 grid size-10 place-items-center rounded-[10px] bg-card text-tx shadow-e1">
          <Icon name="cloud-off" size={18} />
        </span>
        <p class="m-0 text-16 font-semibold text-tx">The demo didn’t start here</p>
        <p class="m-0 mb-3.5 text-14 text-tx-3">
          Your browser blocked it, or the connection dropped.
        </p>
        <div class="flex flex-wrap justify-center gap-2">
          <button
            type="button"
            data-retry
            class="inline-flex h-8.5 cursor-pointer items-center rounded-card bg-card px-3.5 text-14 font-medium text-tx shadow-e1 hover:bg-hover"
          >
            Retry
          </button>
          <a
            href={first?.path ?? DEMO_URL}
            data-follow
            target="_blank"
            rel="noopener"
            class="inline-flex h-8.5 items-center gap-1.5 rounded-card bg-acc-fill px-3.5 text-14 font-medium text-on-acc hover:bg-acc-600 hover:text-on-acc"
          >
            Open in a new tab
            <Icon name="external" size={14} />
          </a>
        </div>
      </div>
    </div>
    <a
      href={first?.path ?? DEMO_URL}
      data-try
      class="absolute bottom-3 left-1/2 z-2 inline-flex h-9 -translate-x-1/2 items-center gap-2 rounded-full bg-tx px-3.5 text-13 font-medium whitespace-nowrap text-canvas shadow-e2 hover:text-canvas sm:bottom-5.5 sm:h-10.5 sm:px-4 sm:text-14h"
    >
      <Icon name="play" size={13} class="fill-current" />
      Try it live
      <kbd class="hidden rounded-[5px] border border-current/25 px-1.25 font-mono text-11 font-normal opacity-80 sm:inline">
        Enter
      </kbd>
    </a>
  </div>
  <figcaption class="text-13 text-tx-3">
    Nothing you change leaves the page, and a reload starts over.
  </figcaption>
</figure>

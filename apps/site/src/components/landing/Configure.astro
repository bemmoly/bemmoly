---
import { CONFIGS } from '../../data/landing.ts';
---

<section class="mx-auto flex w-full max-w-290 flex-col gap-8 px-4 py-20 sm:px-6 lg:px-12">
  <div class="flex max-w-175 flex-col gap-2.5">
    <h2 class="text-24 leading-display font-semibold tracking-display">
      Configure everything. Lock what matters.
    </h2>
    <p class="text-16 leading-doc text-tx-2">
      Org admins set defaults and roles. Project admins override columns, lanes, fields, workflows
      and estimation for their team. Members see a board that fits how they actually work.
    </p>
  </div>
  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {CONFIGS.map((config) => (
      <li class="flex flex-col gap-2 rounded-window border border-line bg-card p-4.5 text-tx">
        <h3 class="text-16 font-semibold">{config.title}</h3>
        <p class="text-13 leading-brief text-tx-3">{config.body}</p>
        <a href={config.demo} class="mt-auto pt-1.5 text-13 font-medium">
          See it in the live demo
        </a>
      </li>
    ))}
  </ul>
</section>

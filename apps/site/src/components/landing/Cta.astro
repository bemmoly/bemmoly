---
/**
 * The final call, inside the footer block: the brand line closes the story it opened, the
 * three promises once more, and the same command with the same copy button as the hero, with
 * the demo and GitHub as peers.
 */
import { DEMO_URL, REPO_URL } from '../../lib/links.ts';
import Button from '../site/Button.astro';
import CommandField from '../site/CommandField.astro';
import Icon from '../site/Icon.astro';
import Logo from '../site/Logo.astro';
---

<div class="bg-[linear-gradient(180deg,var(--canvas),var(--acc-50))] px-4 pt-18 pb-16 text-center sm:px-6 md:pt-24 md:pb-22">
  <div class="mb-5.5 flex justify-center">
    <Logo variant="mark" size={48} />
  </div>
  <h2 class="text-32 font-semibold tracking-section text-balance md:text-44">
    Your work. Your platform.
  </h2>
  <p class="mt-3 text-17 text-pretty text-tx-2 md:text-19">
    Free forever. Open source. Nothing to buy, now or later.
  </p>
  <div class="mx-auto mt-7.5 flex w-full max-w-120 flex-col gap-2.5 md:max-w-none md:flex-row md:items-center md:justify-center md:gap-3">
    <CommandField id="cta-command" size="lg" class="md:w-auto" />
    <Button variant="secondary" size="lg" href={DEMO_URL}>
      <Icon name="play" size={12} class="fill-current" />
      Try the live demo
    </Button>
    <Button variant="ghost" size="lg" href={REPO_URL}>
      <Icon name="star" size={15} />
      Star on GitHub
    </Button>
  </div>
</div>

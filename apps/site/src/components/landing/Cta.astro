---
import { REPO_URL } from '../../lib/links.ts';
import Button from '../site/Button.astro';
---

<div class="mx-auto flex max-w-290 flex-col items-center gap-5 px-4 py-16 text-center sm:px-6 lg:px-12">
  <h2 class="text-32 leading-heading font-semibold tracking-display">
    Your team's work, on your server, by tonight.
  </h2>
  <div class="flex flex-wrap justify-center gap-3">
    <Button variant="primary" href="/self-hosting">
      Deploy in 5 minutes
    </Button>
    <Button variant="secondary" href={REPO_URL}>
      Star on GitHub
    </Button>
  </div>
</div>

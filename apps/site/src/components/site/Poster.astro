---
/**
 * A picture of the product, captured from the demo in its light and dark themes
 * (scripts/capture-previews.ts), as AVIF and WebP at several widths. One <picture> holds both
 * themes: the dark sources carry a prefers-color-scheme media query, so a browser downloads
 * only the picture for the theme it shows. When a visitor picks a theme in the footer, the
 * site script rewrites those queries (data-themed) so the picture follows the page.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** Widths to generate, in px; the source's own width is the largest. */
  widths: readonly number[];
  sizes: string;
  eager?: boolean;
  hidden?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  light,
  dark,
  alt,
  widths,
  sizes,
  eager = false,
  hidden,
  class: className,
  ...data
} = Astro.props;

async function sources(image: ImageMetadata) {
  const list = [...new Set([...widths, image.width])].filter((w) => w <= image.width);
  const [avif, webp] = await Promise.all([
    getImage({ src: image, format: 'avif', widths: list }),
    getImage({ src: image, format: 'webp', widths: list }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute };
}

const [day, night, fallback] = await Promise.all([
  sources(light),
  sources(dark),
  getImage({ src: light, format: 'webp', width: Math.min(widths.at(-1) ?? 1280, light.width) }),
]);
const DARK = '(prefers-color-scheme: dark)';
---

<picture data-themed hidden={hidden} {...data}>
  <source type="image/avif" media={DARK} srcset={night.avif} sizes={sizes} data-dark />
  <source type="image/webp" media={DARK} srcset={night.webp} sizes={sizes} data-dark />
  <source type="image/avif" srcset={day.avif} sizes={sizes} />
  <source type="image/webp" srcset={day.webp} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class:list={['block h-auto w-full', className]}
  />
</picture>

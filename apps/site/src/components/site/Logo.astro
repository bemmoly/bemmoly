---
/**
 * The brand, inlined from @bemmoly/ui's brand folder (the only source of the logo): the
 * re-cut lockup, whose lettering is set at 115% so the word carries beside the mark (ADR 0015),
 * or the mark alone. The -color files draw the four tiles in their designed colours on every
 * theme and the lettering in currentColor. The files are 24 units tall; `size` is the height in
 * px (the site review's nav draws the lockup 26px tall, its footer 22px).
 */
import lockup from '@bemmoly/ui/brand/lockup-color.svg?raw';
import mark from '@bemmoly/ui/brand/mark-color.svg?raw';

interface Props {
  variant?: 'lockup' | 'mark';
  /** Height in px; one of the steps below. */
  size?: 14 | 22 | 24 | 26 | 30 | 48;
  class?: string;
}

const { variant = 'lockup', size = 26, class: className } = Astro.props;
// Heights as classes: the strict HTML rules allow no inline style.
const HEIGHTS: Readonly<Record<NonNullable<Props['size']>, string>> = {
  14: 'h-3.5',
  22: 'h-5.5',
  24: 'h-6',
  26: 'h-6.5',
  30: 'h-7.5',
  48: 'h-12',
};
// The wrapper names the brand (or the link around it does); the drawing is decoration.
const svg = (variant === 'mark' ? mark : lockup)
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace(/\srole="img"\saria-label="[^"]*"/, ' aria-hidden="true" focusable="false"');
---

<span
  class:list={[
    'inline-flex shrink-0 text-tx [&>svg]:h-full [&>svg]:w-auto',
    HEIGHTS[size],
    className,
  ]}
  set:html={svg}
/>

---
/**
 * The brand lockup, inlined from @bemmoly/ui's brand folder (the only source of the logo).
 * The -color file draws the mark in its designed colours (the variables it reads are only set
 * for a workspace's custom brand, never on the site) and the lettering in currentColor. The
 * file is 24 units tall; the wrapper's height scales it (the Landing mock's brand block is 28px
 * tall).
 */
import lockup from '@bemmoly/ui/brand/lockup-color.svg?raw';

const svg = lockup.replace(/\s(width|height)="[^"]*"/g, '');
---

<span class="inline-flex h-7 text-tx [&>svg]:h-full [&>svg]:w-auto" set:html={svg} />

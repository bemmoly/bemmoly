---
/**
 * A command or file in the Landing mock's terminal style (Dark preset, 13px/1.7 mono,
 * 10px radius, 16px padding). Lines starting with "$ " get the dimmed prompt. With `copy`,
 * the header gets the install pill's Copy button, which copies the lines without prompts;
 * the page includes CopyScript once for it. Long lines scroll, so the code is focusable for
 * keyboard scrolling.
 */
interface Props {
  code: string;
  label?: string;
  copy?: boolean;
}

const { code, label, copy = false } = Astro.props;
const lines = code.replace(/\n$/, '').split('\n');
const copied = lines.map((line) => (line.startsWith('$ ') ? line.slice(2) : line)).join('\n');
---

<figure
  data-theme="dark"
  class="m-0 min-w-0 overflow-hidden rounded-window border border-line bg-sunken text-tx-2"
>
  {(label || copy) && (
    <figcaption class="flex items-center gap-3 border-b border-line px-3 py-2.5 font-mono text-12 text-tx-3">
      {label}
      {copy && (
        <button
          type="button"
          data-copy={copied}
          class="ml-auto cursor-pointer font-sans text-13 text-tx-3 hover:text-tx-2"
        >
          Copy
        </button>
      )}
    </figcaption>
  )}
  <code tabindex="0" class="block overflow-x-auto p-4 font-mono text-13 leading-prose">
    {lines.map((line) =>
      line.startsWith('$ ') ? (
        <span class="block whitespace-nowrap">
          <span class="text-tx-3" aria-hidden="true">
            $
          </span>{' '}
          <span class="whitespace-pre" set:text={line.slice(2)} />
        </span>
      ) : (
        <span class="block whitespace-pre" set:text={line || ' '} />
      ),
    )}
  </code>
</figure>

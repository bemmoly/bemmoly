---
/**
 * The install command as the call to action, copy-first (site review, hero): a dark field with
 * the prompt, the command as selectable text and the copy button. On a phone the command wraps
 * instead of scrolling, so Copy is always in reach. Without the script the command is still
 * text a visitor can select and copy. With `value` it shows a one-line preview and copies the
 * whole text instead (the agent prompt); `target` then names where the whole text is kept for
 * the clipboard fallback.
 */
import { INSTALL_COMMAND } from '../../lib/links.ts';
import CopyButton from './CopyButton.astro';

interface Props {
  /** A unique id for the command text, the clipboard fallback's selection. */
  id: string;
  command?: string;
  /** What Copy puts on the clipboard, when it is more than the line shown. */
  value?: string;
  target?: string;
  copyLabel?: string;
  size?: 'md' | 'lg';
  class?: string;
}

const {
  id,
  command = INSTALL_COMMAND,
  value,
  target = id,
  copyLabel,
  size = 'md',
  class: className,
} = Astro.props;
---

<div
  data-theme="dark"
  class:list={[
    'flex max-w-full items-start gap-3 rounded-[10px] bg-sunken py-2 pr-2 pl-4 text-left font-mono text-tx shadow-e1 sm:items-center',
    size === 'lg' ? 'min-h-12 text-14 sm:min-h-14 sm:pl-5 sm:text-16' : 'min-h-12 text-14',
    className,
  ]}
>
  {value === undefined && (
    <span class="pt-1.75 text-tx-3 select-none sm:pt-0" aria-hidden="true">
      $
    </span>
  )}
  <code
    id={id}
    class:list={[
      'min-w-0 flex-1 pt-1.75 sm:pt-0',
      value === undefined
        ? 'break-all select-all sm:break-normal sm:whitespace-nowrap'
        : 'truncate text-tx-2',
    ]}
  >
    {command}
  </code>
  <CopyButton value={value ?? command} target={target} label={copyLabel} />
</div>

---
/**
 * The homepage, from the site design review: the story is built around the three promises
 * (100% open source, no pricing, no in-app purchases), stated in the hero, given a section of
 * their own with proof, answered in the FAQ and repeated in the final call and the footer.
 */
import AiBand from '../components/landing/AiBand.astro';
import Cta from '../components/landing/Cta.astro';
import Faq from '../components/landing/Faq.astro';
import Hero from '../components/landing/Hero.astro';
import Install from '../components/landing/Install.astro';
import OpenSource from '../components/landing/OpenSource.astro';
import Own from '../components/landing/Own.astro';
import Promise from '../components/landing/Promise.astro';
import Showcase from '../components/landing/Showcase.astro';
import Switch from '../components/landing/Switch.astro';
import { HOME_FAQ } from '../data/faq.ts';
import { pageAt } from '../data/pages.ts';
import Base from '../layouts/Base.astro';
---

<Base page={pageAt('/')} faq={HOME_FAQ}>
  <Hero />
  <Promise />
  <Showcase />
  <AiBand />
  <Own />
  <Install />
  <Switch />
  <OpenSource />
  <Faq />
  <Cta slot="cta" />
</Base>

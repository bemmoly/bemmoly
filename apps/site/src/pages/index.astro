---
import AiSection from '../components/landing/AiSection.astro';
import Configure from '../components/landing/Configure.astro';
import Cta from '../components/landing/Cta.astro';
import Features from '../components/landing/Features.astro';
import Hero from '../components/landing/Hero.astro';
import ProductPreview from '../components/landing/ProductPreview.astro';
import SelfHost from '../components/landing/SelfHost.astro';
import { pageAt } from '../data/pages.ts';
import Base from '../layouts/Base.astro';
---

<Base page={pageAt('/')}>
  <Hero />
  <div class="mx-auto w-full max-w-300 px-4 pb-20 sm:px-6 lg:px-8">
    <ProductPreview />
  </div>
  <Features />
  <AiSection />
  <SelfHost />
  <Configure />
  <Cta slot="cta" />
</Base>

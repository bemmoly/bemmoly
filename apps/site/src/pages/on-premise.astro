---
/**
 * Topic page for on-premise and data ownership. Almost all of it is the kernel, which ships
 * today: storage and backups (packages/core services/storage, services/system/backups), the
 * opt-in update check, signed updates (deploy/updater) and the audit log.
 */
import Badge from '../components/site/Badge.astro';
import Section from '../components/site/Section.astro';
import Capabilities from '../components/topics/Capabilities.astro';
import InstallCta from '../components/topics/InstallCta.astro';
import Related from '../components/topics/Related.astro';
import { pageAt } from '../data/pages.ts';
import { STATUS } from '../data/self-hosting.ts';
import type { Capability } from '../data/topics.ts';
import Page from '../layouts/Page.astro';

const WHERE = [
  ['Records', 'Your Postgres 18: the one the installer runs next to the app, or your own.'],
  [
    'Files and attachments',
    'The server’s disk under /var/bemmoly/data, or an S3-compatible bucket you own.',
  ],
  [
    'Backups',
    'The server’s disk under /var/bemmoly/backups, plus an S3-compatible bucket if you add one.',
  ],
  [
    'Keys',
    'The .env file on your server. It decrypts stored credentials; backups never contain it.',
  ],
] as const;

const CONTROLS: readonly Capability[] = [
  {
    icon: 'database',
    title: 'Backups you can trust',
    body: 'Daily at 02:00 by default, kept 7 days, 4 weeks and 3 months, checked as each is written and test-restored every week.',
    status: 'now',
  },
  {
    icon: 'lock',
    title: 'Encrypted off the machine',
    body: 'Backups sent to a bucket are encrypted with AES-256-GCM using a passphrase only your server holds.',
    status: 'now',
  },
  {
    icon: 'shield',
    title: 'Signed updates',
    body: 'Release images are signed; the updater verifies the signature before it installs anything.',
    status: 'now',
  },
  {
    icon: 'restore',
    title: 'Rollback for a week',
    body: 'Every update takes a backup first, rolls back by itself if the health check fails, and can be undone for 7 days.',
    status: 'now',
  },
  {
    icon: 'checklist',
    title: 'An audit log',
    body: 'Who changed settings, modules and backups, and when, exportable as CSV.',
    status: 'now',
  },
  {
    icon: 'key',
    title: 'Single sign-on',
    body: 'OIDC and SAML sign-in, and SCIM to keep people and groups in step with your directory.',
    status: 'integrations',
  },
];
---

<Page
  page={pageAt('/on-premise')}
  heading="Your work data on your own server"
  lede="Bemmoly runs where you put it: a VM in your own cloud account, a server in your rack, or a network with no way out. Your records, files, backups and keys stay in places you own, and the app calls no one you have not configured."
  wide
>
  <Section title="Where everything lives">
    <div tabindex="0" class="overflow-x-auto rounded-card border border-line">
      <table class="w-full border-collapse text-left text-14">
        <thead class="bg-side text-12 font-semibold tracking-caps text-tx-3 uppercase dark:bg-card">
          <tr>
            <th class="px-3.5 py-2.5 font-semibold">What</th>
            <th class="px-3.5 py-2.5 font-semibold">Where</th>
          </tr>
        </thead>
        <tbody>
          {WHERE.map(([what, where]) => (
            <tr class="border-t border-line-2 align-top">
              <td class="px-3.5 py-2.5 font-medium whitespace-nowrap text-tx">{what}</td>
              <td class="px-3.5 py-2.5">{where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section title="What leaves the server">
    <ul>
      <li>
        <strong>Nothing by default.</strong> There is no usage telemetry, and the daily check for
        new releases stays off until an admin turns it on in Settings › Updates.
      </li>
      <li>
        <strong>Email</strong> goes through the mail server you configure, and nowhere until you do.
      </li>
      <li>
        <strong>AI</strong>, once it ships, will talk only to the provider you connect, which can be
        a model on your own network. Until you connect one, nothing is sent.
      </li>
      <li>
        <strong>Metrics</strong> for your own Prometheus sit behind a scrape token the installer
        generates; without the token, /metrics answers 404.
      </li>
    </ul>
  </Section>

  <Section title="Controls that ship today">
    <Capabilities items={CONTROLS} />
  </Section>

  <Section title="No internet at all">
    <p class="flex flex-wrap items-center gap-2">
      <Badge tone={STATUS.offline.tone}>{STATUS.offline.label}</Badge>
    </p>
    <p>
      Every release has a bundle with the images, the installer, the Compose file and checksums.
      Copy it to a machine that already has Docker and install with
      <code>--image-archive</code>; later updates are uploaded the same way. The bundle is built for
      each release but has not been tested on an offline network yet.
      <a href="/self-hosting#air-gapped">Self-hosting</a> has the commands.
    </p>
  </Section>

  <Section title="Reporting a security problem">
    <p>
      Report vulnerabilities privately, as the <a href="/security">security policy</a> describes.
      The code is open, so anyone can read exactly what runs on your server.
    </p>
  </Section>

  <InstallCta />
  <Related current="/on-premise" />
</Page>

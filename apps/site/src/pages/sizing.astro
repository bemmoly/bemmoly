---
/**
 * How big a server Bemmoly needs, for search: the same measured tier card the self-hosting
 * guide shows, then what the guide leaves out: the estimator, how it was measured and every
 * price with its source. Data from src/data/capacity.json and src/data/prices.json.
 */
import BoardShot from '../components/sizing/BoardShot.astro';
import Estimator from '../components/sizing/Estimator.astro';
import Method from '../components/sizing/Method.astro';
import PriceTable from '../components/sizing/PriceTable.astro';
import TierCard from '../components/sizing/TierCard.astro';
import Button from '../components/site/Button.astro';
import Section from '../components/site/Section.astro';
import { pageAt } from '../data/pages.ts';
import Page from '../layouts/Page.astro';
import { INSTALL_HREF } from '../lib/links.ts';
---

<Page
  page={pageAt('/sizing')}
  heading="How big a server do I need?"
  lede="One small server runs it. These are load-tested numbers, and anything not yet measured says so."
  wide
>
  <TierCard level="h2" />
  <BoardShot />
  <Section title="Estimate for your data" id="estimate">
    <p>
      Move the sliders to roughly how many issues and doc pages you have. Comments grow with issues
      in our tests.
    </p>
    <Estimator />
  </Section>
  <Method />
  <PriceTable />
  <div class="flex flex-wrap gap-2.5">
    <Button variant="primary" href={INSTALL_HREF}>
      Install on your server
    </Button>
    <Button variant="secondary" href="/self-hosting">
      Read the self-hosting guide
    </Button>
  </div>
</Page>

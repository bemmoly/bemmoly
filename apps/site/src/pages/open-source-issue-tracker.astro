---
/**
 * Topic page for "open source issue tracker". Facts from the Work module's 0.2.0 release
 * notes (modules/work/CHANGELOG.md) and tech design §14 and §16; what comes later says when.
 */
import CodeBlock from '../components/site/CodeBlock.astro';
import Section from '../components/site/Section.astro';
import BoardShot from '../components/topics/BoardShot.astro';
import Capabilities from '../components/topics/Capabilities.astro';
import InstallCta from '../components/topics/InstallCta.astro';
import Related from '../components/topics/Related.astro';
import StatusNote from '../components/topics/StatusNote.astro';
import { RELEASE } from '../data/landing.ts';
import { pageAt } from '../data/pages.ts';
import type { Capability } from '../data/topics.ts';
import Page from '../layouts/Page.astro';

const CAPABILITIES: readonly Capability[] = [
  {
    tile: 'IT',
    title: 'Issue types and fields',
    body: 'Epic, story, bug, task, incident and subtask to start, or types of your own, each with its custom fields and create form.',
    status: 'now',
  },
  {
    tile: 'WF',
    title: 'Workflows you draw',
    body: 'Statuses and transitions in a visual editor, with conditions, validators and post-actions, validated before you publish.',
    status: 'now',
  },
  {
    tile: 'IS',
    title: 'The whole issue',
    body: 'Rich text descriptions, subtasks, linked issues, threaded comments with reactions, the history and a work log.',
    status: 'now',
  },
  {
    tile: 'QL',
    title: 'A query language',
    body: 'Filter with a short, readable query that is checked and completed as you type, then save it for yourself or a team.',
    status: 'now',
  },
  {
    tile: 'PR',
    title: 'Projects with members',
    body: 'People and teams join a project with a role; everyone sees only the projects they belong to.',
    status: 'now',
  },
  {
    tile: 'SR',
    title: 'Search, mentions and live updates',
    body: 'Find issues by key or keyword from ⌘K, get notified when mentioned, and see changes as people make them.',
    status: 'now',
  },
  {
    tile: 'VC',
    title: 'Labels, versions and components',
    body: 'Per project, with release dates on versions and a lead on each component.',
    status: 'now',
  },
  {
    tile: 'AI',
    title: 'Issue summaries',
    body: 'An AI summary of each issue that cites its comments and linked work, with the provider you choose.',
    status: 'ai',
  },
  {
    tile: 'AU',
    title: 'Automation and code links',
    body: 'Rules that act on events or a schedule, outgoing webhooks, and links to branches and pull requests.',
    status: 'integrations',
  },
];

const QUERY = 'project = PLT AND status != Done AND assignee = me ORDER BY updated DESC';
---

<Page
  page={pageAt('/open-source-issue-tracker')}
  heading="An open source issue tracker you host yourself"
  lede="Bemmoly's Work module is an issue tracker for your own server: issue types and custom fields, workflows you draw, a query language for every list, and the full history of every issue, all in your Postgres and under the MIT license."
  wide
>
  <StatusNote>
    The Work module ships in Bemmoly {RELEASE.version}. It is in every install and stays off until
    an admin turns it on in Settings › Modules and chooses who can use it.
  </StatusNote>

  <Section title="What it tracks">
    <Capabilities items={CAPABILITIES} />
  </Section>

  <Section title="One query language for every list">
    <p>
      The board's filter bar, saved filters and swimlanes share one small query language. The
      browser checks a query and suggests fields, operators and values as you type; Postgres runs
      it, and you only ever see issues from projects you belong to.
    </p>
    <CodeBlock code={QUERY} label="Bemmoly Query Language" />
  </Section>

  <BoardShot />

  <Section title="Self-hosted from the start">
    <ul>
      <li>
        <strong>Your database.</strong> Issues, comments and history live in your Postgres 18, and
        every change to members, boards and sprints is in the audit log.
      </li>
      <li>
        <strong>Search without a search cluster.</strong> Keyword and prefix search run in Postgres
        itself, so there is no Elasticsearch to run.
      </li>
      <li>
        <strong>Access you decide.</strong> Roles with organisation-wide locks, module access per
        team, and a role per project member.
      </li>
      <li>
        <strong>Moving in.</strong> Import from Jira, CSV files and other sources is planned for
        0.5, keeping issue keys, comments, history and attachments.
      </li>
    </ul>
  </Section>

  <InstallCta title="Track issues on your own server" />
  <Related current="/open-source-issue-tracker" />
</Page>

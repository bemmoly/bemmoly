---
import AfterInstall from '../components/self-hosting/AfterInstall.astro';
import Paths from '../components/self-hosting/Paths.astro';
import Recommended from '../components/self-hosting/Recommended.astro';
import Sizing from '../components/self-hosting/Sizing.astro';
import WhatYouGet from '../components/self-hosting/WhatYouGet.astro';
import CopyScript from '../components/site/CopyScript.astro';
import StatusNote from '../components/topics/StatusNote.astro';
import Page from '../layouts/Page.astro';
import { RELEASE } from '../data/landing.ts';
import { pageAt } from '../data/pages.ts';
---

<Page
  page={pageAt('/self-hosting')}
  lede="Bemmoly is one container next to one Postgres. For almost everyone the answer is one command on a fresh VM; if you already run something, start from that instead."
  wide
>
  <StatusNote>
    Bemmoly {RELEASE.version} is the foundation (the installer, the setup wizard, people and roles,
    backups and updates) and the Work module, with issues, boards, the backlog and sprints. The
    badges say where each way to run it stands; the <a href="/docs/install">install guide</a>
    walks through the recommended path, and the <a href="/changelog">changelog</a> lists every
    release.
  </StatusNote>
  <Recommended />
  <Paths />
  <WhatYouGet />
  <AfterInstall />
  <Sizing />
  <CopyScript />
</Page>

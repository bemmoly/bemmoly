---
/** Every release, from the packages' release notes (src/lib/changelog.ts), newest first. */
import { pageAt } from '../data/pages.ts';
import Page from '../layouts/Page.astro';
import { groupByKind, paragraphHtml, RELEASES, releaseId, UPCOMING } from '../lib/changelog.ts';
import { REPO_URL } from '../lib/links.ts';

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<Page
  page={pageAt('/changelog')}
  lede="Every release, newest first, in the words of its release notes: what changed, and the configuration and schema changes an admin should know about before updating."
  alternate={{ href: '/changelog.xml', type: 'application/rss+xml', title: 'Bemmoly releases' }}
>
  <p class="text-14h leading-desc text-tx-2">
    Follow along in a feed reader with the <a href="/changelog.xml">RSS feed</a>, or watch releases
    on <a href={`${REPO_URL}/releases`}>GitHub</a>, where each one lists its downloads and how to
    verify the signed images.
  </p>
  <ol class="flex flex-col gap-10">
    {RELEASES.map((release) => (
      <li
        id={releaseId(release.version)}
        class="flex scroll-mt-20 flex-col gap-4 border-t border-line-2 pt-6"
      >
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="font-mono text-20 font-semibold text-tx">
            <a
              href={`/changelog#${releaseId(release.version)}`}
              class="text-tx no-underline hover:text-tx"
            >
              {release.version}
            </a>
          </h2>
          <span class="rounded-full bg-green-50 px-2 py-0.5 text-12 font-semibold text-green-tx">
            {release.date ? (
              <time datetime={release.date}>{formatDate(release.date)}</time>
            ) : (
              'released'
            )}
          </span>
        </div>
        {groupByKind(release.changes).map((group) => (
          <section class="flex flex-col gap-2">
            <h3 class="text-16 font-semibold text-tx">{group.title}</h3>
            <ul class="flex list-disc flex-col gap-3 pl-5 text-16 leading-desc text-tx-2 [&_code]:font-mono [&_code]:text-13 [&_code]:text-tx [&_code]:wrap-anywhere">
              {group.changes.map((change) => (
                <li
                  class="pl-1 [&>*+*]:mt-2 [&_ul]:list-[circle] [&_ul]:pl-5"
                  set:html={change.paragraphs.map(paragraphHtml).join('')}
                />
              ))}
            </ul>
          </section>
        ))}
        {release.changes.length === 0 && (
          <p class="text-16 leading-desc text-tx-2">
            A maintenance release with no notes of its own.
          </p>
        )}
      </li>
    ))}
  </ol>
  <section aria-labelledby="next" class="flex flex-col gap-3 border-t border-line-2 pt-6">
    <h2 id="next" class="text-20 leading-title font-semibold tracking-title text-tx">
      Coming next
    </h2>
    <ul class="flex list-disc flex-col gap-1.5 pl-5 text-16 leading-desc text-tx-2">
      {UPCOMING.map((step) => (
        <li class="pl-1">
          <strong class="font-semibold text-tx">{step.title}:</strong> {step.scope}.
        </li>
      ))}
    </ul>
  </section>
</Page>

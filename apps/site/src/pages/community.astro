---
import Section from '../components/site/Section.astro';
import { pageAt } from '../data/pages.ts';
import Page from '../layouts/Page.astro';
import { CODE_OF_CONDUCT_URL, CONTRIBUTING_URL, ISSUES_URL, REPO_URL } from '../lib/links.ts';
---

<Page
  page={pageAt('/community')}
  lede="Bemmoly is built in the open under the MIT license. Here is where to talk to the people building it."
>
  <Section title="GitHub" id="github">
    <p>
      The code, the plans and the design live in <a href={REPO_URL}>github.com/bemmoly/bemmoly</a>.
      Report bugs and ask for features in <a href={ISSUES_URL}>issues</a>. Security problems go
      privately, as described on the <a href="/security">security page</a>.
    </p>
  </Section>
  <Section title="Discord" id="discord">
    <p>
      A Discord server for questions and show-and-tell is planned. The invite link is not published
      yet; it will appear here.
    </p>
  </Section>
  <Section title="Contributing" id="contributing">
    <p>
      Read <a href={CONTRIBUTING_URL}>the contributing guide</a> before opening a pull request, and
      the <a href={CODE_OF_CONDUCT_URL}>code of conduct</a> that applies everywhere the project
      meets.
    </p>
  </Section>
</Page>

# Every key the server reads. Parsed once by zod in packages/core/src/config/env.ts;
# the process exits on a bad value. Empty means unset.

# Postgres connection. Unset: the server starts and /readyz reports "degraded".
DATABASE_URL=postgres://bemmoly:change-me@db:5432/bemmoly_db
# 32 bytes, base64. Generated by the installer (openssl rand -base64 32). Required.
BEMMOLY_SECRET_KEY=
# Generated by the installer; encrypts off-box backups. Keep it with this file.
BEMMOLY_BACKUP_PASSPHRASE=
# The URL people open. Required.
BEMMOLY_PUBLIC_URL=https://bemmoly.example.com
# all | api | worker
BEMMOLY_ROLE=all
# Empty: every module in the image (later chosen in the wizard / Settings). Or pin: work,docs
BEMMOLY_MODULES=
# Attachments and other stored files (the disk object store) live under this directory.
BEMMOLY_DATA_DIR=/var/bemmoly/data
# The HTTP port the server listens on.
PORT=8080
# fatal | error | warn | info | debug
LOG_LEVEL=info
# json | pretty (pretty is for a terminal; `pnpm dev` sets it)
LOG_FORMAT=json
# true when a reverse proxy such as Caddy sits in front
BEMMOLY_TRUST_PROXY=true
# Rate limits, always on; these only change the maximum. Empty: the default in brackets.
# API requests per signed-in person per minute [600]
BEMMOLY_RATE_LIMIT_PER_USER=
# Sign-in, password reset, invitation, setup and unsubscribe requests per IP per route per minute [10]
BEMMOLY_RATE_LIMIT_AUTH_PER_IP=
# Sign-in, password reset and invitation accept attempts per account per route per 15 minutes [10]
BEMMOLY_RATE_LIMIT_AUTH_PER_ACCOUNT=
# Refused session cookies and API tokens per IP per minute, before more are checked [60]
BEMMOLY_RATE_LIMIT_FAILED_CREDENTIALS_PER_IP=
# Messages one collaborative editing socket (/collab) may send per 10 seconds [600]
BEMMOLY_RATE_LIMIT_COLLAB_MESSAGES=
# Largest message a /collab socket may send, in bytes, 65536 to 16777216 [2097152]
BEMMOLY_COLLAB_MAX_MESSAGE_BYTES=
# true to let AI and SMTP targets live on the LAN (Ollama)
BEMMOLY_ALLOW_PRIVATE_URLS=false
# Optional OpenTelemetry collector base URL (traces go to <url>/v1/traces). Empty: tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bearer token Prometheus presents to scrape /metrics. Empty: /metrics answers 404.
# At least 32 characters; generate with: openssl rand -hex 32
BEMMOLY_METRICS_TOKEN=
# false when changesets run as a separate step (Helm pre-upgrade hook)
BEMMOLY_DB_AUTO_MIGRATE=true
# Changelog contexts this install runs, comma separated: production | demo | test
BEMMOLY_DB_CONTEXTS=production
# Where backups are written; the installer mounts /var/bemmoly/backups here.
BEMMOLY_BACKUP_DIR=/var/bemmoly/backups
# The release, set by the image from its tag. Empty means the server package version.
# Recorded on changelog rows, shown in Settings › Updates and written into backup manifests.
BEMMOLY_VERSION=
# The updater on the internal network; empty when installed with --no-in-app-updates.
BEMMOLY_UPDATER_URL=
# Shared secret between the app and the updater. Generated by the installer.
UPDATER_TOKEN=
# Postgres 18 client tools (pg_dump, pg_restore) used by backups; set in the image.
BEMMOLY_PG_BIN_DIR=/usr/lib/postgresql/18/bin

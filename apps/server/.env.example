# Every key the server reads. Parsed once by zod in packages/core/src/config/env.ts;
# the process exits on a bad value. Empty means unset.

# Postgres connection: Postgres 18 or later with pgvector and pg_trgm (checked at boot).
# Unset: the server starts and /readyz reports "degraded".
DATABASE_URL=postgres://bemmoly:change-me@db:5432/bemmoly_db
# 32 bytes, base64. Generated by the installer (openssl rand -base64 32). Required.
BEMMOLY_SECRET_KEY=
# Generated by the installer; encrypts off-box backups. Keep it with this file.
BEMMOLY_BACKUP_PASSPHRASE=
# The URL people open. Required.
BEMMOLY_PUBLIC_URL=https://bemmoly.example.com
# all | api | worker
BEMMOLY_ROLE=all
# Empty: every module in the image (later chosen in the wizard / Settings). Or pin: work,docs
# Bemmoly Pipelines is the "pipelines" module: once it is enabled and granted, its own app is
# served at <BEMMOLY_PUBLIC_URL>/pipelines/ on this origin, sharing sign-in (ADR 0037). It
# needs no key of its own.
BEMMOLY_MODULES=
# Attachments and other stored files (the disk object store) live under this directory.
BEMMOLY_DATA_DIR=/var/bemmoly/data
# The HTTP port the server listens on.
PORT=8080
# fatal | error | warn | info | debug
LOG_LEVEL=info
# json | pretty (pretty is for a terminal; `pnpm dev` sets it)
LOG_FORMAT=json
# true when a reverse proxy such as Caddy sits in front
BEMMOLY_TRUST_PROXY=true
# Rate limits, always on; these only change the maximum. Empty: the default in brackets.
# API requests per signed-in person per minute [600]
BEMMOLY_RATE_LIMIT_PER_USER=
# Sign-in, password reset, invitation, setup and unsubscribe requests per IP per route per minute [10]
BEMMOLY_RATE_LIMIT_AUTH_PER_IP=
# Sign-in, password reset and invitation accept attempts per account per route per 15 minutes [10]
BEMMOLY_RATE_LIMIT_AUTH_PER_ACCOUNT=
# Refused session cookies and API tokens per IP per minute, before more are checked [60]
BEMMOLY_RATE_LIMIT_FAILED_CREDENTIALS_PER_IP=
# Requests per signed-in person per minute to each route that calls an AI model: answers,
# plans, summary refreshes, ghost text, /ai writes, suggested fixes, provider tests [60]
BEMMOLY_RATE_LIMIT_AI_PER_USER=
# Requests per person per minute to the built-in MCP server (/mcp), reads and writes [120]
BEMMOLY_RATE_LIMIT_MCP_PER_USER=
# Requests per IP per minute to MCP client sign-in: OAuth discovery, /oauth/token and /oauth/revoke [60]
BEMMOLY_RATE_LIMIT_OAUTH_PER_IP=
# File uploads (images pasted or dropped into a page) per signed-in person per minute [30]
BEMMOLY_RATE_LIMIT_UPLOADS_PER_USER=
# Largest file upload in bytes, 65536 to 104857600 [10485760]
BEMMOLY_UPLOAD_MAX_BYTES=
# Document messages one collaborative editing socket (/collab) may send per 10 seconds [1200];
# caret and selection updates have their own budget of three times this
BEMMOLY_RATE_LIMIT_COLLAB_MESSAGES=
# Largest message a /collab socket may send, in bytes, 65536 to 16777216 [2097152]
BEMMOLY_COLLAB_MAX_MESSAGE_BYTES=
# true to let AI and SMTP targets live on the LAN (Ollama)
BEMMOLY_ALLOW_PRIVATE_URLS=false
# Absolute path of a JSON file of canned AI replies (the recorded provider, for e2e tests).
# When set, no AI provider is ever called. Empty: off.
BEMMOLY_AI_RECORDING=
# Optional OpenTelemetry collector base URL (traces go to <url>/v1/traces). Empty: tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bearer token Prometheus presents to scrape /metrics. Empty: /metrics answers 404.
# At least 32 characters; generate with: openssl rand -hex 32
BEMMOLY_METRICS_TOKEN=
# false when changesets run as a separate step (Helm pre-upgrade hook)
BEMMOLY_DB_AUTO_MIGRATE=true
# Most connections the pool opens. Empty: four per CPU, between 10 and 40. With several
# processes on one database, keep their sum under Postgres's max_connections (100 by default).
BEMMOLY_DB_POOL_MAX=
# Database pool limits in milliseconds; 0 switches one off. The longest one statement may run,
# the longest a connection may sit idle inside a transaction, and the longest a request waits
# for a free connection before it fails with 503 (instead of hanging the install).
BEMMOLY_DB_STATEMENT_TIMEOUT_MS=10000
BEMMOLY_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
BEMMOLY_DB_ACQUIRE_TIMEOUT_MS=10000
# A pool query made inside one of the pool's own transactions: warn | throw. Use throw in
# development, so a deadlock waiting to happen fails at once instead of under load.
BEMMOLY_DB_NESTED_ACQUIRE=warn
# Changelog contexts this install runs, comma separated: production | demo | test
BEMMOLY_DB_CONTEXTS=production
# Where backups are written; the installer mounts /var/bemmoly/backups here.
BEMMOLY_BACKUP_DIR=/var/bemmoly/backups
# Uploaded files (page images, the workspace logo, attachments) in an S3-compatible bucket,
# used when the system.storage.backend setting is s3; empty keeps them under BEMMOLY_DATA_DIR.
# Backups copy the uploads out of the bucket into every backup, and a restore puts them back.
BEMMOLY_STORAGE_S3_BUCKET=
BEMMOLY_STORAGE_S3_REGION=us-east-1
# Empty for the provider's default endpoint; set for MinIO, R2, B2 or any other S3 service.
BEMMOLY_STORAGE_S3_ENDPOINT=
BEMMOLY_STORAGE_S3_ACCESS_KEY_ID=
BEMMOLY_STORAGE_S3_SECRET_ACCESS_KEY=
# true for most self-hosted S3-compatible servers (path-style addressing)
BEMMOLY_STORAGE_S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, so one bucket can hold several installs
BEMMOLY_STORAGE_S3_PREFIX=
# The release, set by the image from its tag. Empty means the server package version.
# Recorded on changelog rows, shown in Settings › Updates and written into backup manifests.
BEMMOLY_VERSION=
# The updater on the internal network; empty when installed with --no-in-app-updates.
BEMMOLY_UPDATER_URL=
# Shared secret between the app and the updater. Generated by the installer.
UPDATER_TOKEN=
# Postgres 18 client tools (pg_dump, pg_restore) used by backups; set in the image.
BEMMOLY_PG_BIN_DIR=/usr/lib/postgresql/18/bin
# The optional PDF renderer (the `pdf` Compose profile, or pdf.enabled in Helm). Empty: Export
# as PDF uses the browser's print view instead.
BEMMOLY_PDF_URL=
# Longest one PDF render may take, in ms (5000 to 300000).
BEMMOLY_PDF_TIMEOUT_MS=60000
# Largest PDF kept, and largest HTML sent to the renderer, in bytes.
BEMMOLY_PDF_MAX_BYTES=52428800

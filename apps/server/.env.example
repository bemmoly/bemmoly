# Every key the server reads. Parsed once by zod in packages/core/src/config/env.ts;
# the process exits on a bad value. Empty means unset.

# Postgres connection. Unset: the server starts and /readyz reports "degraded".
DATABASE_URL=postgres://bemmoly:change-me@db:5432/bemmoly_db
# 32 bytes, base64. Generated by the installer (openssl rand -base64 32). Required.
BEMMOLY_SECRET_KEY=
# Generated by the installer; encrypts off-box backups. Keep it with this file.
BEMMOLY_BACKUP_PASSPHRASE=
# The URL people open. Required.
BEMMOLY_PUBLIC_URL=https://bemmoly.example.com
# all | api | worker
BEMMOLY_ROLE=all
# Empty: every module in the image (later chosen in the wizard / Settings). Or pin: work,docs
BEMMOLY_MODULES=
# Attachments and other stored files (the disk object store) live under this directory.
BEMMOLY_DATA_DIR=/var/bemmoly/data
# The HTTP port the server listens on.
PORT=8080
# fatal | error | warn | info | debug
LOG_LEVEL=info
# json | pretty (pretty is for a terminal; `pnpm dev` sets it)
LOG_FORMAT=json
# true when a reverse proxy such as Caddy sits in front
BEMMOLY_TRUST_PROXY=true
# true to let AI and SMTP targets live on the LAN (Ollama)
BEMMOLY_ALLOW_PRIVATE_URLS=false
# Optional OpenTelemetry collector base URL (traces go to <url>/v1/traces). Empty: tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bearer token Prometheus presents to scrape /metrics. Empty: /metrics answers 404.
# At least 32 characters; generate with: openssl rand -hex 32
BEMMOLY_METRICS_TOKEN=
# false when changesets run as a separate step (Helm pre-upgrade hook)
BEMMOLY_DB_AUTO_MIGRATE=true
# Changelog contexts this install runs, comma separated: production | demo | test
BEMMOLY_DB_CONTEXTS=production

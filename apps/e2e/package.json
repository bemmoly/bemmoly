  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@bemmoly/core": "workspace:*",
    "@bemmoly/server": "workspace:*",
    "@bemmoly/web": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4"
  }
}

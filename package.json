    "test:e2e": "turbo run test:e2e",
    "size": "turbo run size",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}

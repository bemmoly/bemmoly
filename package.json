{
  "name": "bemmoly",
  "version": "0.0.0",
  "private": true,
  "description": "Open source, self-hosted, AI-first issues and docs for your whole company",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build",

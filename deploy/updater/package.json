{
  "name": "@bemmoly/updater",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Swaps the Bemmoly app container for a new or previous version on request, over the internal network only",
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bemmoly/shared": "workspace:*",
    "dockerode": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.1",
    "@types/node": "26.6.4",
    "vitest": "5.0.3"
  }
}

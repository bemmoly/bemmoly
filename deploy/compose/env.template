# Bemmoly install settings, read by docker compose and by the app.
#
# KEEP A COPY OF THIS FILE SOMEWHERE SAFE. It holds BEMMOLY_SECRET_KEY, which decrypts
# the provider keys, SMTP passwords and SSO secrets stored in the database, and
# BEMMOLY_BACKUP_PASSPHRASE, which decrypts off-box backups. Backups do not contain it.
#
# Change a value with `sudo bemmoly config set KEY VALUE` (it restarts what needs it).

# Versions and optional services (db, proxy, updater)
VERSION=@VERSION@
UPDATER_VERSION=@VERSION@
COMPOSE_PROFILES=@PROFILES@
BEMMOLY_UPDATE_CHANNEL=@CHANNEL@
BEMMOLY_DIR=@DIR@

# Address
BEMMOLY_DOMAIN=@DOMAIN@
BEMMOLY_TLS_MODE=@TLS_MODE@
BEMMOLY_PUBLIC_URL=@PUBLIC_URL@
BEMMOLY_HTTP_BIND=@HTTP_BIND@
BEMMOLY_TRUST_PROXY=true

# Database: the bundled Postgres 18, or set DATABASE_URL and drop "db" from COMPOSE_PROFILES
DATABASE_URL=@DATABASE_URL@
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
PG_SHARED_BUFFERS=@PG_SHARED_BUFFERS@
PG_EFFECTIVE_CACHE_SIZE=@PG_EFFECTIVE_CACHE_SIZE@

# Secrets, generated by the installer
BEMMOLY_SECRET_KEY=@SECRET_KEY@
BEMMOLY_BACKUP_PASSPHRASE=@BACKUP_PASSPHRASE@
UPDATER_TOKEN=@UPDATER_TOKEN@
BEMMOLY_UPDATER_URL=@UPDATER_URL@
# Bearer token for /metrics scrapes; /metrics is off when this is empty
BEMMOLY_METRICS_TOKEN=@METRICS_TOKEN@

# Modules pinned with --modules; empty means chosen in the setup wizard
BEMMOLY_MODULES=@MODULES@

LOG_LEVEL=info
